POSTGRES_PORT=5432
POSTGRES_DB=uptime
POSTGRES_USER=uptime
POSTGRES_PASSWORD=replace-with-random-password
DATABASE_URL=postgres://uptime:replace-with-random-password@localhost:5432/uptime?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=uptime-api
JWT_AUDIENCE=uptime-web
ALLOWED_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Optional Go executable for scripts/dev.mjs when Go is not on PATH.
GO_BIN=go

# Local avatar storage; relative to backend working directory.
AVATAR_DIR=var/avatars
